<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="12dp"
    android:background="@drawable/panel_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="SAN ANDREAS CHEATS" android:textColor="@color/white" android:textStyle="bold"
        android:textSize="18sp" android:gravity="center" />
    <ScrollView android:layout_width="match_parent" android:layout_height="320dp"
        android:layout_marginTop="8dp">
        <LinearLayout android:id="@+id/cheatList" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
    <EditText android:id="@+id/manualCheat" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Manual cheat code"
        android:inputType="textCapCharacters" android:maxLines="1"
        android:textColor="@color/white" android:textColorHint="#99FFFFFF" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/sendManual" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="Send" />
        <Button android:id="@+id/closeMenu" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="Close" />
    </LinearLayout>
</LinearLayout>
